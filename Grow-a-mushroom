-- [ Player Section ]
local MovementGroup = PP:Groupbox("Player Stats", "Left")
MovementGroup:AddSlider({
    Title = "WalkSpeed", Default = 16, Min = 16, Max = 200, Rounding = 0,
    Callback = function(v) S() pcall(function() LocalPlayer.Character.Humanoid.WalkSpeed = v end) end
})

MovementGroup:AddSlider({
    Title = "JumpPower", Default = 50, Min = 50, Max = 300, Rounding = 0,
    Callback = function(v)
        S()
        pcall(function() 
            LocalPlayer.Character.Humanoid.UseJumpPower = true
            LocalPlayer.Character.Humanoid.JumpPower = v 
        end)
    end
})

local InfJumpEnabled = false
MovementGroup:AddToggle({ Title = "Infinite Jump", Default = false, Callback = function(v) S() InfJumpEnabled = v end })
UIS.JumpRequest:Connect(function()
    if InfJumpEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid") then
        LocalPlayer.Character:FindFirstChildOfClass("Humanoid"):ChangeState("Jumping")
    end
end)

-- [ Visuals / ESP Section ]
local ESPGroup = VP:Groupbox("Player Visuals", "Left")
local PlayerESP = false

ESPGroup:AddToggle({
    Title = "Player ESP", Default = false,
    Callback = function(v)
        S() PlayerESP = v
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hl = p.Character:FindFirstChild("APEX_ESP")
                if PlayerESP then
                    if not hl then
                        hl = Instance.new("Highlight", p.Character)
                        hl.Name = "APEX_ESP"
                        hl.FillColor = Color3.fromRGB(255, 0, 0)
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    end
                else
                    if hl then hl:Destroy() end
                end
            end
        end
    end
})

-- [ Server Utility Section ]
local ServerGroup = SP:Groupbox("Server Utility", "Right")

ServerGroup:AddButton({
    Title = "Rejoin Server",
    Callback = function()
        S()
        TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer)
    end
})

ServerGroup:AddButton({
    Title = "Server Hop",
    Callback = function()
        S()
        pcall(function()
            local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Desc&limit=100")).data
            for _, s in pairs(servers) do
                if s.playing ~= s.maxPlayers and s.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                    break
                end
            end
        end)
    end
})

ServerGroup:AddButton({
    Title = "Small Server Hop",
    Callback = function()
        S()
        pcall(function()
            local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/0?sortOrder=Asc&limit=100")).data
            for _, s in pairs(servers) do
                if s.playing ~= s.maxPlayers and s.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
                    break
                end
            end
        end)
    end
})

