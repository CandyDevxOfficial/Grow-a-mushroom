local L = loadstring(game:HttpGet("https://raw.githubusercontent.com/Vovabro46/trash/refs/heads/main/Test.lua"))()
local RS, SS, UIS, Players = game:GetService("ReplicatedStorage"), game:GetService("SoundService"), game:GetService("UserInputService"), game:GetService("Players")
local TeleportService, HttpService = game:GetService("TeleportService"), game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local function S()
    task.spawn(function()
        local sound = Instance.new("Sound", SS)
        sound.SoundId = "rbxassetid://88368154755133" sound.Volume = 0.5 sound:Play()
        game:GetService("Debris"):AddItem(sound, 2)
    end)
end

L:Watermark("APEX HUB | v 1.0")
local W = L:Window("APEX HUB")
local M = W:Tab("Main", "eye")
local P_Tab = W:Tab("Player", "user")
local V_Tab = W:Tab("Visuals", "eye")
local S_Tab = W:Tab("Settings", "7733771472")

local GP = M:SubTab("General")
local PP = P_Tab:SubTab("Movement")
local VP = V_Tab:SubTab("ESP & Highlights")
local SP = S_Tab:SubTab("Menu Settings")

-- [ Shop & Farm Section ]
local FG = GP:Groupbox("Shop / Seeds", "Left")
local SelectedSeed, AutoBuy, AutoSell = "Galaxy Cap Seed", false, false
local AutoHarvest, AutoPlant = false, false

local SeedList = {"Galaxy Cap Seed", "Candy Puff Seed", "Amethyst Bloom Seed", "Glow Shroom Seed", "Magic Mushroom Seed"}

FG:AddDropdown({
    Title = "Select Seed", Values = SeedList, Default = "Galaxy Cap Seed",
    Callback = function(v) S() SelectedSeed = v end
})

FG:AddToggle({
    Title = "Auto Buy Selected Seed", Default = false,
    Callback = function(v)
        S() AutoBuy = v
        if AutoBuy then
            task.spawn(function()
                while AutoBuy do
                    pcall(function() RS:WaitForChild("BuySeedRequest"):FireServer(SelectedSeed, 0) end)
                    task.wait(0.1)
                end
            end)
        end
    end
})

FG:AddToggle({
    Title = "auto SellAll", Default = false,
    Callback = function(v)
        S() AutoSell = v
        if AutoSell then
            task.spawn(function()
                while AutoSell do
                    pcall(function() RS:WaitForChild("SellEvent"):FireServer("SellAll") end)
                    task.wait(0.5)
                end
            end)
        end
    end
})

